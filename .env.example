# ---- Firebase (Firestore) --------------------------------------------------
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK config
# Add the same 6 values in Vercel -> Project -> Settings -> Environment Variables
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Email of the Firebase Auth admin account used to publish shared settings
VITE_FIREBASE_ADMIN_EMAIL=""

# Store owner's WhatsApp number in international format, digits only (example: 971501234567)
VITE_WHATSAPP_NUMBER=""
