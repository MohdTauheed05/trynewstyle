rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStoreAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Deny access unless a rule below explicitly allows it.
    match /{document=**} {
      allow read, write: if false;
    }

    // Public storefront data; only a provisioned admin may change it.
    match /products/{id} {
      allow read: if true;
      allow write: if isStoreAdmin();
    }
    match /looks/{id} {
      allow read: if true;
      allow write: if isStoreAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      // Other shared sections require the provisioned store-admin record.
      // Reel changes are limited to signed-in Firebase accounts because the storefront
      // has no public Firebase sign-up flow; shoppers remain unauthenticated.
      allow write: if isStoreAdmin() || (
        id == 'shared_reels'
        && request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.data.keys().hasAll(['items'])
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50
      );
    }
    match /system/{id} {
      allow read: if true;
    }

    // Admin role records are provisioned manually in Firebase Console.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // Order pages use an unguessable 12-character token. Only direct reads are
    // public; listing, updates, and deletes are denied. These records contain
    // product/order details only, never customer contact or delivery notes.
    match /orderShares/{token} {
      allow get: if true;
      allow list, update, delete: if false;
      allow create: if token.matches('^[A-Za-z0-9_-]{12}$')
        && request.resource.data.keys().hasOnly([
          'orderId', 'date', 'shopName', 'items', 'total', 'currencySymbol'
        ])
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() <= 40
        && request.resource.data.date is string
        && request.resource.data.shopName is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.currencySymbol is string;
    }

    // Shoppers may create well-formed private orders. Only admins can read/manage them.
    match /orders/{orderId} {
      allow create: if request.resource.data.orderId is string
        && request.resource.data.orderId.size() < 40
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow read, update, delete: if isStoreAdmin();
    }
  }
}