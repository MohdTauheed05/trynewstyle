rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStoreAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Default: deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Storefront data is public to read; only a provisioned store admin can write.
    match /products/{id}  { allow read: if true; allow write: if isStoreAdmin(); }
    match /looks/{id}     { allow read: if true; allow write: if isStoreAdmin(); }
    match /settings/{id}  { allow read: if true; allow write: if isStoreAdmin(); }
    match /system/{id}    { allow read: if true; }

    // Provision admin role documents manually in Firebase Console.
    match /admins/{uid} { allow read, write: if false; }

    // Shoppers can create a well-formed order. Only a store admin can view/manage orders.
    match /orders/{orderId} {
      allow create: if request.resource.data.orderId is string
                    && request.resource.data.orderId.size() < 40
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0;
      allow read, update, delete: if isStoreAdmin();
    }
  }
}
