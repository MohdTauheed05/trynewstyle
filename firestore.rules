rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Public storefront data: anyone can read, only signed-in admins can write
    match /products/{id}  { allow read: if true; allow write: if request.auth != null; }
    match /looks/{id}     { allow read: if true; allow write: if request.auth != null; }
    match /settings/{id}  { allow read: if true; allow write: if request.auth != null; }
    match /system/{id}    { allow read: if true; }

    // Orders: shoppers can only CREATE a well-formed order.
    // Nobody can read/edit/delete orders from the website (view them in Firebase console).
    match /orders/{orderId} {
      allow create: if request.resource.data.orderId is string
                    && request.resource.data.orderId.size() < 40
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0;
      allow read, update, delete: if request.auth != null;
    }
  }
}
